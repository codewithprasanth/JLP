# Copy to .env for LOCAL development only. In production set these in Render's
# environment-variable dashboard — never commit a real .env.

# Database (local: docker compose up -d)
DATABASE_URL=postgresql://foodapp:foodapp@localhost:5433/foodapp

# Redis (Render Key Value in production)
REDIS_URL=redis://localhost:6379

# JWT — use long random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=change-me-otp

# Notifications (Addendum 1) — email via Brevo replaces SMS for v1.
# Leave BREVO_API_KEY blank in development: OTPs and order emails are printed to the console.
NOTIFICATION_CHANNEL=email
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Jinisha Lovely Products
# Status changes that email the customer (order confirmation and cancellation always do)
ORDER_EMAIL_STATUSES=CONFIRMED,OUT_FOR_DELIVERY,DELIVERED
# Production only: true = print notifications/OTPs to the log instead of sending (testing)
NOTIFICATIONS_LOG_ONLY=false
# MSG91 (SMS) — Phase 2, re-add only once DLT registration is complete
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_ORDER_TEMPLATE_ID=

# Cloudinary — leave blank to run without image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN_CUSTOMER=http://localhost:4200
CORS_ORIGIN_ADMIN=http://localhost:4300
# Set to 1 on Render (one proxy hop) so rate limits see the real client IP
TRUST_PROXY=0

# Seed values (used once by `npm run db:seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=   # generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_SHOP_LATITUDE=12.967145
SEED_SHOP_LONGITUDE=77.736177
SEED_DELIVERY_RADIUS_KM=1
SEED_MIN_ORDER_VALUE=100
